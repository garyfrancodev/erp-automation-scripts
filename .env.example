# ============================================================
# .env.example - Plantilla de variables de entorno y secretos
# Copia este archivo a .env si deseas predefinir contraseñas
# o deja que los scripts las generen y guarden automáticamente.
# ============================================================

# --- Usuario de sistema Frappe (autogenerado por 02-create-frappe-user.sh) ---
FRAPPE_USER=frappe
FRAPPE_PASSWORD=tu_contrasena_segura_aqui

# --- Usuario Administrador de MariaDB (autogenerado por 05-install-mariadb.sh) ---
DB_ROOT_USER=frappe
DB_ROOT_PASSWORD=tu_contrasena_mariadb_aqui

# --- Token API de Linode para DNS automático (opcional si usas 1Password CLI) ---
# ERP_DOMAINS_API=linode_api_token_aqui

# --- Contraseñas de Administrador por sitio (autogeneradas al crear sitios) ---
# ADMIN_PASSWORD_CLIENTE1=contrasena_sitio_aqui
