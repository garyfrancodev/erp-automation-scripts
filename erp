#!/bin/bash
# ============================================================
# CLI de administración para Frappe Bench / ERPNext
# Uso: erp <grupo> <accion> [argumentos...] (o ./erp ...)
# ============================================================
set -Eeuo pipefail

# Resolver enlace simbólico de forma canónica para soportar /usr/local/bin/erp
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SCRIPTS_DIR="$ROOT_DIR/scripts"


usage() {
  cat <<'EOF'
🚀 ERP Automation CLI

Uso:
  erp <grupo> <accion> [argumentos...]   (o ./erp ...)

Comandos disponibles:

  🌐 Sitios:
    erp site list                                       Lista todos los sitios configurados en el Bench
    erp site create <subdominio> [db-user db-pass]      Crea sitio nuevo, subdominio Linode y apps
    erp site drop <sitio>                               Elimina un sitio y su base de datos
    erp site ssl <sitio> <correo>                       Habilita certificado SSL Let's Encrypt

  📦 Aplicaciones (Custom Apps):
    erp app list                                        Lista todas las apps instaladas en el Bench
    erp app install <repo-url> [sitio]                  Descarga e instala una custom app en un sitio



  💾 Respaldos:
    erp backup create <sitio>                           Genera respaldo completo con archivos
    erp backup copy <origen> <destino>                  Copia respaldos entre sitios
    erp backup restore <sitio>                          Restaura el respaldo más reciente

  🏗️ Bench:
    erp bench all                                       Ejecuta init, apps y prod en un solo paso
    erp bench init                                      Inicializa el Bench de Frappe (usuario frappe)
    erp bench apps                                      Descarga ERPNext, HRMS y Webshop
    erp bench prod                                      Configura producción (Nginx, Supervisor)

  🔄 Servicios:
    erp restart                                         Reinicia workers de Frappe y recarga Nginx
    erp status                                          Muestra estado de Nginx, Supervisor y MariaDB

  ⚙️ Servidor:
    erp server setup                                    Aprovisiona servidor completo (root / sudo)
    erp server update                                   Actualiza paquetes del sistema

  ❓ Ayuda:
    erp help                                            Muestra este mensaje

EOF
  exit "${1:-0}"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  site)
    action="${1:-}"
    shift || true
    case "$action" in
      create)  bash "$SCRIPTS_DIR/sites/create-site.sh" "$@" ;;
      drop|delete) bash "$SCRIPTS_DIR/sites/drop-site.sh" "$@" ;;
      ssl)     bash "$SCRIPTS_DIR/sites/enable-ssl.sh" "$@" ;;
      list)

        # shellcheck source=scripts/core/lib.sh
        source "$SCRIPTS_DIR/core/lib.sh"
        echo "========================================"
        echo "🌐 Sitios configurados en Frappe Bench:"
        echo "========================================"
        if [ -d "$BENCH_PATH/sites" ]; then
          found=0
          for s in "$BENCH_PATH"/sites/*/; do
            if [ -f "${s}site_config.json" ]; then
              site_name="$(basename "$s")"
              echo "  • $site_name"
              found=1
            fi
          done
          if [ "$found" -eq 0 ]; then
            echo "  (Ningún sitio creado todavía)"
          fi
        else
          echo "❌ Directorio $BENCH_PATH/sites no encontrado (¿Bench no instalado aún?)."
        fi
        echo "========================================"
        ;;
      *)       echo "❌ Acción desconocida para 'site'. Opciones: list, create, drop, ssl"; usage 1 ;;
    esac
    ;;

  app)
    action="${1:-}"
    shift || true
    case "$action" in
      install|get|add) bash "$SCRIPTS_DIR/apps/install-app.sh" "$@" ;;
      list)            bash "$SCRIPTS_DIR/apps/list-apps.sh" "$@" ;;
      *)               echo "❌ Acción desconocida para 'app'. Opciones: list, install"; usage 1 ;;
    esac
    ;;


  backup)
    action="${1:-}"
    shift || true
    case "$action" in
      create)  bash "$SCRIPTS_DIR/backups/generate-backup.sh" "$@" ;;
      copy)    bash "$SCRIPTS_DIR/backups/copy-backup.sh" "$@" ;;
      restore) bash "$SCRIPTS_DIR/backups/restore-backup.sh" "$@" ;;
      *)       echo "❌ Acción desconocida para 'backup'. Opciones: create, copy, restore"; usage 1 ;;
    esac
    ;;

  bench)
    action="${1:-}"
    shift || true
    case "$action" in
      all)
        echo "🚀 Iniciando configuración completa de Frappe Bench y Producción..."
        bash "$SCRIPTS_DIR/02-bench-setup/01-install-frappe.sh"
        bash "$SCRIPTS_DIR/02-bench-setup/02-install-apps.sh"
        bash "$SCRIPTS_DIR/02-bench-setup/03-setup-production.sh"
        echo ""
        echo "🎉 ¡Todo el entorno Frappe Bench y Producción ha quedado configurado con éxito!"
        echo "   Ya puedes crear tu primer sitio con: erp site create <subdominio>"
        ;;
      init) bash "$SCRIPTS_DIR/02-bench-setup/01-install-frappe.sh" "$@" ;;
      apps) bash "$SCRIPTS_DIR/02-bench-setup/02-install-apps.sh" "$@" ;;
      prod) bash "$SCRIPTS_DIR/02-bench-setup/03-setup-production.sh" "$@" ;;
      *)    echo "❌ Acción desconocida para 'bench'. Opciones: all, init, apps, prod"; usage 1 ;;
    esac
    ;;

  restart)
    # shellcheck source=scripts/core/lib.sh
    source "$SCRIPTS_DIR/core/lib.sh"
    echo "🔄 Reiniciando Supervisor, workers y recargando Nginx..."
    sudo systemctl restart supervisor 2>/dev/null || true
    sudo supervisorctl restart all 2>/dev/null || true
    sudo nginx -t && sudo systemctl reload nginx
    echo "✅ Servicios reiniciados correctamente."
    ;;

  server)
    action="${1:-}"
    shift || true
    case "$action" in
      setup)  bash "$ROOT_DIR/setup.sh" "$@" ;;
      update) bash "$SCRIPTS_DIR/01-server-setup/01-update-system.sh" "$@" ;;
      *)      echo "❌ Acción desconocida para 'server'. Opciones: setup, update"; usage 1 ;;
    esac
    ;;

  status)
    echo "========================================"
    echo "📊 Estado de los Servicios ERPNext"
    echo "========================================"
    echo -n "🌐 Nginx:       "
    sudo systemctl is-active nginx 2>/dev/null || echo "inactivo / no instalado"
    echo -n "🛢️ MariaDB:     "
    sudo systemctl is-active mariadb 2>/dev/null || echo "inactivo / no instalado"
    echo -n "🛡️ Fail2ban:    "
    sudo systemctl is-active fail2ban 2>/dev/null || echo "inactivo / no instalado"
    echo ""
    echo "⚙️ Supervisor (Procesos Frappe):"
    sudo supervisorctl status 2>/dev/null || echo "Supervisor no está activo o no configurado aún."
    echo "========================================"
    ;;

  help|--help|-h|"")
    usage 0
    ;;

  *)
    echo "❌ Comando desconocido: '$cmd'"
    usage 1
    ;;
esac
