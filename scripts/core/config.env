# ============================================================
# Configuración común de los scripts (valores por defecto).
# Cada valor puede sobreescribirse exportando la variable antes
# de ejecutar un script, p. ej.:  DOMAIN_NAME=midominio.com bash scripts/sites/create-site.sh cliente1
# Los secretos NO van aquí: se guardan en .env (ignorado por git).
# ============================================================

# --- Frappe / Bench ---
FRAPPE_USER="${FRAPPE_USER:-frappe}"
FRAPPE_BRANCH="${FRAPPE_BRANCH:-version-15}"
BENCH_NAME="${BENCH_NAME:-frappe-bench}"
BENCH_APPS="${BENCH_APPS:-erpnext hrms webshop}"   # apps que se descargan (bench get-app)
SITE_APPS="${SITE_APPS:-erpnext hrms}"             # apps que se instalan en cada sitio nuevo

# --- Sistema ---
NODE_MAJOR="${NODE_MAJOR:-20}"
TIMEZONE="${TIMEZONE:-America/La_Paz}"
SWAP_SIZE="${SWAP_SIZE:-2G}"                       # vacío o "0" = no crear swap
ENABLE_UFW="${ENABLE_UFW:-true}"
SSH_PORT="${SSH_PORT:-22}"
INNODB_BUFFER_POOL_SIZE="${INNODB_BUFFER_POOL_SIZE:-}"   # p. ej. 1G (vacío = valor por defecto de MariaDB)

# --- DNS (Linode) ---
DOMAIN_NAME="${DOMAIN_NAME:-mandox.com.bo}"
SERVER_IP="${SERVER_IP:-172.235.142.98}"
OP_DOMAINS_REF="${OP_DOMAINS_REF:-op://ERP/ERP_DOMAINS/credential}"
